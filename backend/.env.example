PORT=3001
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key

# Gateway de pagamento (Mercado Pago)
# mock = fluxo PIX simulado, sem credencial (aprova automaticamente após alguns segundos)
# live = usa a API real do Mercado Pago (exige MERCADOPAGO_ACCESS_TOKEN)
PAYMENTS_MODE=mock
# Access Token do Mercado Pago (Checkout API). Obrigatório quando PAYMENTS_MODE=live.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública do backend para receber o webhook do Mercado Pago (ex: https://xxxx.ngrok.io)
PUBLIC_BASE_URL=
